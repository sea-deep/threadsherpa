# ThreadSherpa Configuration Template
# Copy to .env and adjust variables as required

# Environment & Logging
NODE_ENV=development
LOG_LEVEL=info

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_DEV_GUILD_ID=your_development_guild_id_here_optional

# SQLite Database Location
DATABASE_PATH=./data/threadsherpa.sqlite

# Local Open-Weight Model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
OLLAMA_TIMEOUT_MS=60000

# GitHub Integration (Optional - for GitHub issue search and drafts)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_REPO=owner/repo

# Support Autonomy & Investigation Budgets
DEFAULT_AUTONOMY_MODE=supervised
MAX_INVESTIGATION_ROUNDS=3
MAX_TOOL_CALLS_PER_INVESTIGATION=6
INVESTIGATION_TIMEOUT_MS=45000
ALLOWED_DOMAINS=docs.github.com,nodejs.org,discord.com
