# Start here: docs/SETUP.md
# Free setup needs the Discord token and Atlas URI. Paper is optional.
DISCORD_BOT_TOKEN=
MONGODB_URI=
PAPER_INSTRUMENTS_API_KEY=

# Free normal operation: Gemma reasoning and embeddings run locally through Ollama.
MODEL_PROVIDER=ollama

# Everything below already has a default. Uncomment only if needed.
# MONGODB_DB_NAME=threadsherpa
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b-it-qat
# OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
# DISCORD_DEV_GUILD_ID=your_test_server_id
# SENTRY_DSN=

# MODEL_PROVIDER=paper enables optional Paper synthesis and uses API credit.
# A Discord application ID is detected automatically; no Atlas project ID is needed.
