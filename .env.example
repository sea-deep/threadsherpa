# ThreadSherpa Configuration Template
# Copy to .env and adjust variables as required

# Environment & Logging
NODE_ENV=development
LOG_LEVEL=info

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_DEV_GUILD_ID=your_development_guild_id_here_optional

# Unified Database: MongoDB / MongoDB Atlas
DATABASE_PROVIDER=mongodb
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/threadsherpa?retryWrites=true&w=majority
MONGODB_URI=memory://
MONGODB_DB_NAME=threadsherpa

# AI Model Provider: 'paper' | 'ollama' (default) | 'gemini' | 'groq' | 'openai'
MODEL_PROVIDER=paper

# Choice 1: Paper Instruments (Primary Frontier Reasoning Model)
PAPER_INSTRUMENTS_API_KEY=your_paper_instruments_api_key_here
PAPER_MODEL=ultramarine-1-flash

# Choice 2: Local Open-Weight Model (Ollama)
# MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
OLLAMA_TIMEOUT_MS=60000

# Choice 3: Cloud AI Inference (When running on Render / Cloud)
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_MODEL=gemini-2.0-flash

# (Or Groq)
# MODEL_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_MODEL=llama-3.3-70b-versatile

# (Or OpenAI / OpenRouter)
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=your_openai_or_openrouter_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Partner Tooling & Tracing
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SERPAPI_API_KEY=your_serpapi_key_here

# GitHub Integration (Optional - for issue search and drafts)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_REPO=owner/repo

# Support Autonomy & Investigation Budgets
DEFAULT_AUTONOMY_MODE=supervised
MAX_INVESTIGATION_ROUNDS=3
MAX_TOOL_CALLS_PER_INVESTIGATION=6
INVESTIGATION_TIMEOUT_MS=45000
ALLOWED_DOMAINS=docs.github.com,nodejs.org,discord.com,mongodb.com
