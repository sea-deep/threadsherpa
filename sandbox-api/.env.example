# Campfire sandbox API. Copy this file to sandbox-api/.env.
# This service never reads the bot's root .env and needs no Discord credentials.

SANDBOX_PORT=8787
SANDBOX_HOST=127.0.0.1
SANDBOX_ALLOWED_ORIGIN=http://localhost:4321,http://127.0.0.1:4321
# guided | auto | live. Unset means guided. auto checks the provider, then
# serves live only when a budget is set.
SANDBOX_MODE=auto
SANDBOX_SESSION_TTL_SECONDS=1200
SANDBOX_MAX_ACTIVE_SESSIONS=20
SANDBOX_MAX_CONCURRENT_REQUESTS=2
# Every model call counts, including embeddings and duplicate checks.
SANDBOX_DAILY_MODEL_CALL_LIMIT=200
SANDBOX_MAX_QUESTIONS_PER_SESSION=10
SANDBOX_MAX_SAVES_PER_SESSION=5

# ollama | paper. Paper still uses local Ollama for embeddings.
SANDBOX_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
OLLAMA_TIMEOUT_MS=90000

# Only needed for SANDBOX_MODEL_PROVIDER=paper. Server-side only.
# PAPER_INSTRUMENTS_API_KEY=
# PAPER_MODEL=
