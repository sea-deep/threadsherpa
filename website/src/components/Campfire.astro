---
import '../styles/campfire.css';
import { fixtureThreads, sandboxCopy } from '../../../shared/sandbox';

interface Props { immersive?: boolean; }
const { immersive = false } = Astro.props;
const threads = fixtureThreads();
const initial = threads[0];
const initialMessages = initial?.messages ?? [];

const time = (iso: string, reference = Date.UTC(2026, 9, 23, 17, 40)) => {
  const minutes = Math.max(0, Math.round((reference - Date.parse(iso)) / 60000));
  if (minutes < 1) return 'now';
  if (minutes < 60) return `${minutes}m`;
  const hours = Math.round(minutes / 60);
  return hours < 24 ? `${hours}h` : `${Math.round(hours / 24)}d`;
};
---

<section id="playground" class="stage-section" aria-label={immersive ? 'Campfire interactive sandbox' : undefined} aria-labelledby={immersive ? undefined : 'campfire-heading'}>
  <div class="wrap">
    <div class="stage-rubric">
      <div class="stage-rubric__title">
        <span class="mono" style="color: var(--text-subtle-ink)">Live support sandbox</span>
        <h2 id="campfire-heading">{`Meet Campfire.`}</h2>
      </div>
      <p>A fictional community with a familiar support problem. Open a thread and try the whole flow.</p>
    </div>

    <div
      class="stage"
      data-campfire
      data-mode="guided"
      data-perspective="moderator"
      data-mobile-pane="forum"
      data-channel="support"
      data-immersive={immersive ? 'true' : undefined}
    >
      <canvas class="stage__canvas" data-thread-canvas aria-hidden="true"></canvas>
      <div class="stage__poster" aria-hidden="true">
        <svg viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice" fill="none">
          <path
            d="M-40 500C170 500 220 180 460 214S760 540 980 360 1150 250 1260 268"
            stroke="rgba(242,160,61,0.22)"
            stroke-width="1.2"
            stroke-dasharray="2 8"
            stroke-linecap="round"
          />
          <path
            d="M-20 524C180 524 250 246 470 262S790 566 1000 386 1170 300 1250 310"
            stroke="rgba(242,160,61,0.09)"
            stroke-width="1"
            stroke-dasharray="1 10"
            stroke-linecap="round"
          />
          <circle cx="460" cy="214" r="2.5" fill="rgba(242,160,61,0.5)" />
          <circle cx="980" cy="360" r="2.5" fill="rgba(242,160,61,0.35)" />
        </svg>
      </div>

      <p class="sr-only" role="status" aria-live="polite" data-live-status></p>

      <div class="stage__frame">
        {immersive && <nav class="servers" aria-label="Servers">
          <a class="servers__home" href="/" aria-label="ThreadSherpa home"><img src="/brand/mark.svg" width="28" height="24" alt="" /></a>
          <span class="servers__divider"></span>
          <button class="servers__item is-selected" type="button" data-server-home aria-label="Campfire server" aria-current="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 3c1 5-4 5-2 9 1-1 2-2 2-3 4 3 6 6 4 9a6 6 0 0 1-10-6c0 2 1 3 2 3-1-5 4-6 4-12Z" fill="currentColor" /></svg></button>
          <a class="servers__item servers__add" href="/setup/" aria-label="Set up your own server"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a>
          <a class="servers__help" href="/setup/" aria-label="Setup guide"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-1 .7-1.5 1-1.5 2.5M12 17h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></a>
        </nav>}
        <header class="stage__bar">
          <button
            class="stage__channels"
            type="button"
            data-open-channels
            aria-label="Open channels"
            aria-expanded="false"
          >
            <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true">
              <path d="M1 1h14M1 7h14M1 13h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
          </button>

          <button class="server" type="button" data-server-home aria-label="Campfire support forum">
            <span class="server__mark" aria-hidden="true">
              <svg width="21" height="21" viewBox="0 0 20 20" fill="none">
                <path
                  d="M16.4 13A7.2 7.2 0 1 1 16.4 7"
                  stroke="#F2A03D"
                  stroke-width="1.6"
                  stroke-linecap="round"
                ></path>
                <circle cx="10" cy="10" r="2.1" fill="#F2A03D"></circle>
              </svg>
            </span>
            <span>
              <span class="server__name">Campfire</span>
              <span class="server__sub" data-channel-label>#ask-campfire</span>
            </span>
          </button>

          {immersive && <div class="workspace-channel"><span aria-hidden="true">#</span><strong data-workspace-channel>ask-campfire</strong><span class="workspace-channel__topic">Good questions. Answers that stick.</span></div>}
          <div class="stage__controls">
            <span class="mode-pill" data-mode-pill>
              <span class="mode-pill__dot"></span>
              <span data-mode-label>{sandboxCopy.guidedLabel}</span>
            </span>
            <div class="roles-wrap">
              <div class="roles" role="group" aria-label="Perspective">
                <button type="button" data-perspective="member" aria-pressed="false">Member</button>
                <button type="button" data-perspective="moderator" aria-pressed="true">Moderator</button>
              </div>
              <span class="roles-note">Website role switch</span>
            </div>
            <button class="restart-btn" type="button" data-restart>Restart</button>
          </div>
        </header>

        <div class="stage__body">
          <nav class="rail" aria-label="Campfire channels">
            <button class="rail__back" type="button" data-close-channels>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M8 1 3 6l5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              Back to threads
            </button>
            {immersive && <div class="community-banner"><span class="community-banner__icon" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="m3 19 6-11 4 7 3-5 5 9H3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="17" cy="5" r="2" fill="currentColor"/></svg></span><strong>A little help goes a long way.</strong><span>Your community, with a memory.</span></div>}
            <div class="rail__group">
              <span class="rail__label">{immersive ? 'Community' : 'Channels'}</span>
              <button class="rail__link" type="button" data-channel="announcements">
                <span class="rail__hash" aria-hidden="true">#</span>
                <span class="rail__name">announcements</span>
              </button>
              <button class="rail__link" type="button" data-channel="support" aria-current="true">
                <span class="rail__hash" aria-hidden="true">#</span>
                <span class="rail__name">ask-campfire</span>
              </button>
            </div>
            {immersive && <div class="sandbox-guide"><h2>Make yourself at home</h2><p>Try the bot in three small steps.</p><ol><li data-guide-step="save"><span class="sandbox-guide__check" aria-hidden="true"></span><div><strong>Save a useful answer</strong><p>Open Sam’s message actions.</p></div></li><li data-guide-step="ask"><span class="sandbox-guide__check" aria-hidden="true"></span><div><strong>Ask it a different way</strong><p>Start a new post to try recall.</p></div></li><li data-guide-step="source"><span class="sandbox-guide__check" aria-hidden="true"></span><div><strong>Follow the source</strong><p>See where the answer came from.</p></div></li></ol></div>}
            <div class="rail__foot">
              <strong>Your sandbox</strong>
              In-memory only. Restart clears it.
              <button class="rail__restart" type="button" data-restart>Restart Campfire</button>
            </div>
            {immersive && <div class="sandbox-profile"><span class="sandbox-profile__avatar" aria-hidden="true">Y<span></span></span><div><strong>You</strong><span data-profile-role>Exploring as moderator</span></div></div>}
          </nav>

          <section class="forum" aria-label="Support forum">
            {immersive && <div class="forum__intro"><h2>Support threads</h2><p>A good answer starts here.</p></div>}
            <div class="forum__head">
              <div class="search">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                  <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3"></circle>
                  <path d="m9 9 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                </svg>
                <label class="sr-only" for="campfire-search">Search Campfire threads</label>
                <input
                  id="campfire-search"
                  type="search"
                  placeholder="Find a question"
                  autocomplete="off"
                  data-search
                />
              </div>
              <button class="new-post" type="button" data-new-post>
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                  <path d="M5.5 1v9M1 5.5h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                </svg>
                New post
              </button>
            </div>

            <div class="forum__tabs" role="tablist" aria-label="Moderator tools" data-tool-tabs>
              <button class="tab" type="button" role="tab" data-tool-tab="threads" aria-selected="true">
                Threads
              </button>
              <button class="tab" type="button" role="tab" data-tool-tab="queue" aria-selected="false">
                Queue <span class="count" data-count="queue">0</span>
              </button>
              <button class="tab" type="button" role="tab" data-tool-tab="saved" aria-selected="false" aria-label="Saved answers">
                Saved <span class="count" data-count="saved">0</span>
              </button>
            </div>

            <div class="forum__body" data-forum-body>
              <div class="forum__list" role="list">
                {threads.map((thread, index) => (
                  <button
                    class="thread-row"
                    type="button"
                    role="listitem"
                    data-thread-id={thread.id}
                    aria-current={index === 0 ? 'true' : 'false'}
                  >
                    <span class="thread-row__top">
                      <span class="thread-row__dot" data-status={thread.status}></span>
                      <span class="thread-row__title">{thread.title}</span>
                      <svg class="thread-row__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="m4 2 4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </span>
                    <span class="thread-row__meta">
                      {thread.authorName} · {time(thread.createdAt)} ago · {thread.status === 'open' ? 'Open' : thread.status}
                    </span>
                    <span class="thread-row__snippet">{thread.messages[thread.messages.length - 1]?.body}</span>
                  </button>
                ))}
              </div>
            </div>
          </section>

          <section class="thread" aria-label="Support thread">
            <div class="thread__head">
              <button class="thread__back" type="button" data-back-to-threads>
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M8 1 3 6l5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                Back to threads
              </button>
              <div class="thread__heading">
                <h3 class="thread__title" id="campfire-thread-title" tabindex="-1">{initial?.title}</h3>
                <div class="thread__meta">
                  <span>{initial?.authorName}</span>
                  <span aria-hidden="true">·</span>
                  <span>{time(initial?.createdAt ?? new Date().toISOString())} ago</span>
                  <span class="status-pill" data-status="open">Open</span>
                </div>
              </div>
            </div>

            <div class="thread__scroll" data-thread-scroll>
              <div class="messages" data-messages>
                {initialMessages.map((message) => (
                  <article class="msg" data-message-id={message.id}>
                    {message.author.role === 'bot' ? (
                      <div class="msg__avatar msg__avatar--bot" aria-hidden="true">
                        <img src="/brand/mark.svg" alt="" width="366" height="272" loading="lazy" />
                      </div>
                    ) : (
                      <div class={`msg__avatar${message.author.role === 'moderator' ? ' msg__avatar--sam' : ''}`} aria-hidden="true">
                        {message.author.name.slice(0, 1)}
                      </div>
                    )}
                    <div class="msg__main">
                      <div class="msg__head">
                        <span class="msg__name">{message.author.name}</span>
                        {message.author.role === 'moderator' && <span class="msg__tag">Mod</span>}
                        {message.author.role === 'bot' && <span class="msg__tag msg__tag--bot">Bot</span>}
                        <span class="msg__time">{time(message.at)}</span>
                      </div>
                      {message.kind === 'answer' ? (
                        <div class="answer">
                          <p class="answer__text">{message.body}</p>
                          <div class="answer__foot">
                            <button class="answer__source" type="button" data-source-message={message.id}>
                              Original answer
                            </button>
                            <div class="outcomes">
                              <button class="outcome" type="button" data-outcome="solved">Solved</button>
                              <button class="outcome" type="button" data-outcome="needs_help">Need help</button>
                            </div>
                          </div>
                        </div>
                      ) : (
                        <p class="msg__text">{message.body}</p>
                      )}
                    </div>
                    {message.author.role === 'moderator' && (
                      <button
                        class="msg__actions"
                        type="button"
                        data-actions
                        aria-label="Message actions"
                        aria-haspopup="menu"
                        aria-expanded="false"
                      >
                        <svg width="14" height="4" viewBox="0 0 14 4" fill="none" aria-hidden="true">
                          <circle cx="2" cy="2" r="1.6" fill="currentColor"></circle>
                          <circle cx="7" cy="2" r="1.6" fill="currentColor"></circle>
                          <circle cx="12" cy="2" r="1.6" fill="currentColor"></circle>
                        </svg>
                      </button>
                    )}
                  </article>
                ))}
              </div>
            </div>

            <div class="thread__support" data-support>
              <div class="helper" data-helper>
                <span class="helper__text" data-helper-text>
                  Save this answer, then ask the same thing in your own words.
                </span>
                <button class="btn btn--ghost btn--small" type="button" data-show-me>Show me where</button>
              </div>
            </div>

            <div class="thread__composer">
              <form class="composer" data-reply-form>
                <label class="sr-only" for="campfire-reply">Reply in this thread</label>
                <textarea
                  id="campfire-reply"
                  rows="1"
                  placeholder="Write a reusable answer"
                  maxlength="1000"
                  data-reply-input
                ></textarea>
                <button class="send" type="submit">Send reply</button>
              </form>
            </div>
          </section>
        </div>

        <footer class="stage__foot">
          <p class="stage__disclosure">{sandboxCopy.disclosure}</p>
          <p class="stage__role-note">Website role switch, not Discord permissions.</p>
          <p class="stage__mode-note" data-mode-note>
            <span class="dot" aria-hidden="true"></span>
            <strong>Guided example.</strong>
            Prepared conversations. No live AI replies.
          </p>
          <button class="motion-btn" type="button" data-motion-toggle>Pause motion</button>
        </footer>
      </div>
    </div>
  </div>
</section>

<dialog class="restart-dialog" data-restart-dialog aria-labelledby="restart-title">
  <div class="dialog__body">
    <h2 id="restart-title">Restart Campfire?</h2>
    <p>This clears only your sandbox conversations and saved answers.</p>
    <div class="dialog__actions">
      <button class="btn btn--ghost" type="button" data-cancel-restart>Keep exploring</button>
      <button class="btn btn--primary" type="button" data-confirm-restart>Restart Campfire</button>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/campfire';
</script>
