---
import svg from '../../public/brand/guide.svg?raw';
import '../styles/guide.css';
interface Props { class?: string; pose?: string; label?: string; }
const { class: className = '', pose = 'idle', label } = Astro.props;
---
<span class:list={['guide', className]} data-guide data-pose={pose} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><Fragment set:html={svg} /></span>
