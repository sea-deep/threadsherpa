---
import Base from '../layouts/Base.astro';
---

<Base description="That page is not here. Return to ThreadSherpa.">
  <section class="page-hero">
    <div class="wrap page-hero__inner">
      <p class="kicker">404</p>
      <h1>This trail ends here.</h1>
      <p class="page-hero__lede">
        The page you asked for is not part of the site. The overview and the setup guide are still
        where you left them.
      </p>
      <div class="page-hero__actions">
        <a class="btn btn--primary" href="/">Back to ThreadSherpa</a>
        <a class="btn btn--ghost" href="/setup/">Open the setup guide</a>
      </div>
    </div>
  </section>
</Base>
